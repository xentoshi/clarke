[toolchain]

[features]
seeds = false
skip-lint = false

[programs.devnet]
clarke_program = "3KFUjEeu7efYuvLuAvEeKQqVt3pyoghUafoPSWzYif57"

[registry]
url = "https://api.apr.dev"

[provider]
# Use a public devnet RPC or set ANCHOR_PROVIDER_URL env var
cluster = "https://api.devnet.solana.com"
# Point to your local keypair — never commit the actual path with your username
wallet = "~/.config/solana/id.json"

[scripts]
test = "yarn run ts-mocha -p ./tsconfig.json -t 1000000 tests/**/*.ts"
